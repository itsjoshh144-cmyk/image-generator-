# Server-side only. Never exposed to the browser. Leave unset to run in
# mock/demo mode (no network calls, no key required) with fully working UI.
IMAGE_API_KEY=

# Optional: pin the backend instead of auto-selecting based on IMAGE_API_KEY.
# One of: "mock" | "openai"
IMAGE_PROVIDER=

# Optional: powers the "Enhance Prompt" button with an LLM. Falls back to a
# local template-based enhancer when unset.
GEMINI_API_KEY=
